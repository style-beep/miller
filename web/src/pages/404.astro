---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 | MILLER FAMILY</title>
  <link rel="icon" type="image/png" href="/images/family-logo.jpeg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
</head>
<body>
  <div class="bg"></div>
  <div class="grid-bg"></div>
  <div class="tape-top"></div>
  <div class="tape-bot"></div>

  <div class="wrap">

    <div class="emblem-wrap">
      <img src="/images/miller-emblem.png" alt="" class="emblem"/>
    </div>

    <div class="badge">
      <div class="blink-dot"></div>
      HTTP 404 — PAGE NOT FOUND
    </div>

    <div class="number-404">404</div>

    <h1>Файл уничтожен</h1>

    <div class="sep"><span>отчёт</span></div>

    <p>
      Страница <em id="urlDisplay"></em> не существует,<br>
      была удалена или засекречена.<br>
      <em>Возможно, это тоже часть плана.</em>
    </p>

    <div class="terminal">
      <div class="terminal-bar">
        <div class="t-dot"></div>
        <div class="t-dot"></div>
        <div class="t-dot"></div>
        <span>miller-shell — bash</span>
      </div>
      <div class="terminal-body">
        <div class="tl"><span class="p">$</span><span>curl -I <span id="curlUrl">https://delperro.rp/???</span></span></div>
        <div class="tl"><span class="p">></span><span class="dim">HTTP/1.1 <span class="er">404 Not Found</span></span></div>
        <div class="tl"><span class="p">></span><span class="dim">Server: Miller-Family/2.0</span></div>
        <div class="tl"><span class="p">></span><span class="dim">X-Error: <span class="er">Resource does not exist</span></span></div>
        <div class="tl" style="margin-top:6px"><span class="p">$</span><span>locate <span id="locateUrl">???</span><span class="cur"></span></span></div>
        <div class="tl"><span class="p">></span><span class="er">locate: no such file or directory</span></div>
      </div>
    </div>

    <div class="btn-row">
      <a href="/index.html" class="btn btn-primary">
        <i class="fa-solid fa-house"></i> На главную
      </a>
      <a href="javascript:history.back()" class="btn btn-ghost">
        <i class="fa-solid fa-arrow-left"></i> Назад
      </a>
    </div>

    <div class="quick-links">
      <a href="/gallery.html" class="quick-link"><i class="fa-solid fa-images"></i> Галерея</a>
      <a href="/rules.html"   class="quick-link"><i class="fa-solid fa-scroll"></i> Правила</a>
      <a href="/profile.html" class="quick-link"><i class="fa-solid fa-user"></i> Профиль</a>
      <a href="/map.html"     class="quick-link"><i class="fa-solid fa-map"></i> Карта</a>
      <a href="/dossier.html" class="quick-link"><i class="fa-solid fa-file-shield"></i> Досье</a>
    </div>

  </div>

  <div class="footer">MILLER FAMILY · DEL PERRO RP · 2023–2026</div>

  <script is:inline>
    const path = location.pathname;
    document.getElementById("urlDisplay").textContent  = path;
    document.getElementById("curlUrl").textContent     = "delperro.rp" + path;
    document.getElementById("locateUrl").textContent   = path;
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root { --red: #ff2a2a; }

  body {
    font-family: 'Montserrat', sans-serif;
    background: #050505; color: #fff;
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 20px;
    overflow: hidden;
  }

  .bg {
    position: fixed; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse at 25% 35%, rgba(120,0,0,0.14) 0%, transparent 55%),
      radial-gradient(ellipse at 75% 65%, rgba(80,0,0,0.09) 0%, transparent 50%),
      #050505;
  }
  .bg::after {
    content: '';
    position: fixed; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(
      0deg, transparent 0px, transparent 2px,
      rgba(0,0,0,0.05) 2px, rgba(0,0,0,0.05) 3px
    );
  }

  .grid-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,42,42,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,42,42,0.025) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .tape-top, .tape-bot {
    position: fixed; left: 0; right: 0; height: 4px; z-index: 10;
    background: repeating-linear-gradient(
      -45deg, rgba(200,0,0,0.7) 0px, rgba(200,0,0,0.7) 14px,
      rgba(0,0,0,0.6) 14px, rgba(0,0,0,0.6) 28px
    );
  }
  .tape-top { top: 0; }
  .tape-bot { bottom: 0; }

  .wrap { position: relative; z-index: 1; max-width: 600px; width: 100%; }

  .emblem-wrap { margin-bottom: 20px; }
  .emblem {
    width: 52px; height: 52px; object-fit: contain;
    filter: grayscale(0.7) brightness(0.6);
    animation: float 4s ease-in-out infinite;
  }
  @keyframes float {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-7px); }
  }

  .badge {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,42,42,0.07); border: 1px solid rgba(255,42,42,0.2);
    border-radius: 6px; padding: 6px 16px; margin-bottom: 20px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px; color: rgba(255,42,42,0.6); letter-spacing: 2px;
  }
  .blink-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--red); animation: blink 1.1s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.15} }

  .number-404 {
    font-size: clamp(90px, 20vw, 200px); font-weight: 900;
    letter-spacing: -6px; line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,42,42,0.2);
    position: relative; margin-bottom: 4px;
    animation: glitch 6s ease-in-out infinite;
    user-select: none;
  }
  .number-404::before, .number-404::after {
    content: "404";
    position: absolute; top: 0; left: 0; width: 100%;
  }
  .number-404::before {
    color: rgba(255,0,0,0.12);
    animation: glitch-a 6s ease-in-out infinite;
  }
  .number-404::after {
    color: rgba(0,180,255,0.07);
    animation: glitch-b 6s ease-in-out infinite;
  }
  @keyframes glitch {
    0%,85%,100% { filter:none; transform:none; }
    86% { filter:hue-rotate(40deg); transform:translateX(-4px); }
    87% { filter:none; transform:translateX(4px); }
    88% { transform:none; }
    92% { transform:translateX(-2px) skewX(2deg); }
    93% { transform:none; }
  }
  @keyframes glitch-a {
    0%,85%,100% { clip-path:none; transform:none; }
    86% { clip-path:inset(15% 0 50% 0); transform:translateX(6px); }
    87% { clip-path:inset(60% 0 10% 0); transform:translateX(-6px); }
    88% { clip-path:none; }
  }
  @keyframes glitch-b {
    0%,85%,100% { clip-path:none; transform:none; }
    86% { clip-path:inset(45% 0 25% 0); transform:translateX(-4px); }
    87% { clip-path:inset(10% 0 65% 0); transform:translateX(4px); }
    88% { clip-path:none; }
  }

  h1 {
    font-size: clamp(16px, 3.5vw, 28px); font-weight: 900;
    letter-spacing: 6px; color: #fff; margin-bottom: 8px;
    text-transform: uppercase;
  }

  .sep {
    display: flex; align-items: center; gap: 14px;
    margin: 16px auto; max-width: 340px;
  }
  .sep::before, .sep::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,42,42,0.25), transparent);
  }
  .sep span { font-size: 9px; letter-spacing: 3px; color: rgba(255,42,42,0.35); text-transform: uppercase; }

  p {
    font-size: 13px; color: rgba(255,255,255,0.25);
    letter-spacing: 0.5px; line-height: 1.9;
    max-width: 420px; margin: 0 auto 28px;
    font-family: 'Share Tech Mono', monospace;
  }
  p em { color: rgba(255,255,255,0.45); font-style: normal; }

  .terminal {
    background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; overflow: hidden;
    margin: 0 auto 28px; max-width: 440px; text-align: left;
  }
  .terminal-bar {
    background: rgba(255,255,255,0.04); padding: 9px 14px;
    display: flex; align-items: center; gap: 6px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .t-dot { width: 10px; height: 10px; border-radius: 50%; }
  .t-dot:nth-child(1) { background: rgba(255,95,87,0.6); }
  .t-dot:nth-child(2) { background: rgba(255,188,46,0.6); }
  .t-dot:nth-child(3) { background: rgba(39,201,63,0.6); }
  .terminal-bar span {
    margin-left: auto; font-family: 'Share Tech Mono', monospace;
    font-size: 10px; color: rgba(255,255,255,0.2); letter-spacing: 1px;
  }
  .terminal-body { padding: 14px 18px; }
  .tl {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px; color: rgba(255,255,255,0.3);
    margin-bottom: 5px; display: flex; gap: 10px;
  }
  .tl .p  { color: rgba(255,42,42,0.5); flex-shrink: 0; }
  .tl .ok { color: rgba(67,181,129,0.7); }
  .tl .er { color: rgba(255,42,42,0.6); }
  .tl .dim{ color: rgba(255,255,255,0.15); }
  .cur {
    display: inline-block; width: 8px; height: 13px;
    background: rgba(255,42,42,0.5); vertical-align: middle;
    animation: blink 1s step-end infinite; margin-left: 3px;
  }

  .btn-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
  .btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 12px 26px; border-radius: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 10px; font-weight: 800;
    letter-spacing: 2px; text-decoration: none;
    text-transform: uppercase; cursor: pointer; border: 1px solid;
    transition: all 0.2s;
  }
  .btn-primary {
    background: rgba(255,42,42,0.1); border-color: rgba(255,42,42,0.3);
    color: rgba(255,80,80,0.9);
  }
  .btn-primary:hover {
    background: rgba(255,42,42,0.2); border-color: rgba(255,42,42,0.55);
    color: #fff; transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,42,42,0.18);
  }
  .btn-ghost {
    background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.3);
  }
  .btn-ghost:hover {
    background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.6); transform: translateY(-2px);
  }

  .quick-links {
    display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;
  }
  .quick-link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 8px;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    font-size: 10px; font-weight: 700; letter-spacing: 1px;
    color: rgba(255,255,255,0.25); text-decoration: none;
    text-transform: uppercase; transition: all 0.2s;
  }
  .quick-link:hover {
    background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.55);
  }
  .quick-link i { font-size: 11px; }

  .footer {
    position: fixed; bottom: 14px;
    font-size: 9px; letter-spacing: 3px;
    color: rgba(255,255,255,0.05); text-transform: uppercase;
  }
</style>
