---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLoader from '../components/PageLoader.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<BaseLayout title="МЕДИА | MILLER FAMILY">
  <PageLoader
    barTitle="MILLER FAMILY · MEDIA ARCHIVE"
    logoSub="Media Archive System"
    section="МЕДИА АРХИВ"
    initialLabel="Загрузка медиафайлов..."
    barMetaLabel="РАСШИФРОВКА АРХИВА"
  />

  <PageHeader
    links={[
      { href: '/gallery.html', label: 'Галерея' },
      { href: '/allies.html', label: 'Союзники' },
      { href: '/history.html', label: 'История' },
    ]}
  />

  <main id="pageContent">
    <section class="page-section">
      <div class="page-bg-title">MEDIA</div>
      <h1 class="page-section-title">Медиа</h1>
      <p class="page-section-sub">Видео, стримы и клипы Miller Family</p>

      <div class="media-grid" id="mediaGrid"></div>

      <div class="media-note">
        <i class="fa-solid fa-film" style="color:rgba(255,42,42,0.4);margin-right:8px"></i>
        Медиа добавляются через <code style="color:rgba(255,42,42,0.5)">events.config.js</code> в массив <code style="color:rgba(255,42,42,0.5)">MEDIA</code>
      </div>
    </section>

    <PageFooter />
  </main>
</BaseLayout>

<style>
  .media-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .media-card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.07);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    text-decoration: none;
    display: block;
    opacity: 0;
    transform: translateY(20px);
  }
  .media-card.visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.3s, border-color 0.3s;
  }
  .media-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255,42,42,0.3);
    box-shadow: 0 16px 40px rgba(0,0,0,0.6);
  }

  .media-thumb {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #0a0000;
  }
  .media-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.4s ease;
    filter: brightness(0.7);
  }
  .media-card:hover .media-thumb img {
    transform: scale(1.06);
    filter: brightness(0.85);
  }

  .media-platform {
    position: absolute;
    top: 12px; left: 12px;
    width: 36px; height: 36px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; backdrop-filter: blur(8px);
  }
  .platform-youtube { background: rgba(255,0,0,0.7); }
  .platform-twitch  { background: rgba(100,65,165,0.7); }
  .platform-video   { background: rgba(255,42,42,0.7); }

  .media-play {
    position: absolute;
    inset: 0;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
    background: rgba(0,0,0,0.3);
  }
  .media-card:hover .media-play { opacity: 1; }
  .media-play i {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: rgba(255,42,42,0.85);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #fff;
    box-shadow: 0 0 24px rgba(255,42,42,0.5);
  }

  .media-date {
    position: absolute;
    bottom: 10px; right: 12px;
    font-size: 9px; letter-spacing: 2px;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    background: rgba(0,0,0,0.6);
    padding: 3px 8px; border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .media-body { padding: 18px 20px 20px; }
  .media-title {
    font-size: 14px; font-weight: 800;
    letter-spacing: 1px; color: #fff;
    margin-bottom: 8px; line-height: 1.4;
  }
  .media-desc {
    font-size: 12px; color: rgba(255,255,255,0.4);
    line-height: 1.6; margin-bottom: 14px;
  }
  .media-footer {
    display: flex; align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .media-author {
    font-size: 10px; color: rgba(255,42,42,0.6);
    font-weight: 700; letter-spacing: 1px;
    display: flex; align-items: center; gap: 6px;
  }
  .media-author::before {
    content: '';
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255,42,42,0.6);
  }
  .media-link {
    font-size: 10px; font-weight: 700;
    letter-spacing: 2px; color: rgba(255,255,255,0.25);
    display: flex; align-items: center; gap: 5px;
    transition: color 0.2s;
  }
  .media-card:hover .media-link { color: rgba(255,42,42,0.7); }

  .media-card:first-child { grid-column: span 2; }
  .media-card:first-child .media-thumb { aspect-ratio: 16/7; }
  .media-card:first-child .media-title { font-size: 18px; }

  .media-note {
    max-width: 600px; margin: 32px auto 0;
    padding: 16px 24px; border-radius: 10px;
    background: rgba(255,42,42,0.05);
    border: 1px solid rgba(255,42,42,0.15);
    font-size: 12px; color: rgba(255,255,255,0.3);
    text-align: center; line-height: 1.6;
  }

  @media (max-width: 900px) {
    .media-grid { grid-template-columns: repeat(2,1fr); }
    .media-card:first-child { grid-column: span 2; }
  }
  @media (max-width: 600px) {
    .media-grid { grid-template-columns: 1fr; }
    .media-card:first-child { grid-column: span 1; }
  }
</style>

<script type="module" is:inline>
  import { requireAuth }    from "/js/auth-guard.js";
  import { initPageLoader } from "/js/page-loader.js";
  import { initPageTransition } from "/js/page-transition.js";
  import { initEasterEgg }      from "/js/easter-egg.js";
  import { MEDIA }          from "/js/config/events.js";

  const PLATFORM_ICONS = {
    youtube: { icon: 'fa-brands fa-youtube',  cls: 'platform-youtube', label: 'YouTube' },
    twitch:  { icon: 'fa-brands fa-twitch',   cls: 'platform-twitch',  label: 'Twitch'  },
    video:   { icon: 'fa-solid fa-film',       cls: 'platform-video',   label: 'Видео'   },
  };

  requireAuth().then(user => {
    if (!user) return;
    initPageTransition();
    initEasterEgg();
    initPageLoader({
      password: "MF·MEDIA·ARCHIVE·2026",
      label:    "ЗАГРУЗКА МЕДИА АРХИВА",
      onComplete: render,
    });
  });

  function render() {
    const grid = document.getElementById("mediaGrid");

    grid.innerHTML = MEDIA.map((m, i) => {
      const p = PLATFORM_ICONS[m.type] || PLATFORM_ICONS.video;
      return `
        <a href="${m.url}" target="_blank" class="media-card">
          <div class="media-thumb">
            <img loading="lazy" src="${m.thumb}" alt="${m.title}" >
            <div class="media-platform ${p.cls}">
              <i class="${p.icon}"></i>
            </div>
            <div class="media-play"><i class="fa-solid fa-play"></i></div>
            <div class="media-date">${m.date}</div>
          </div>
          <div class="media-body">
            <div class="media-title">${m.title}</div>
            <div class="media-desc">${m.desc}</div>
            <div class="media-footer">
              <div class="media-author">${m.author}</div>
              <div class="media-link">${p.label} <i class="fa-solid fa-arrow-up-right-from-square"></i></div>
            </div>
          </div>
        </a>
      `;
    }).join("");

    const cards = grid.querySelectorAll(".media-card");
    const obs = new IntersectionObserver(entries => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add("visible"), i * 120);
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    cards.forEach(c => obs.observe(c));
  }
</script>
