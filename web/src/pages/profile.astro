function renderAchievements(unlocked) {
  return ALL_ACHIEVEMENTS.map(a => {
    const isUnlocked = unlocked.includes(a.id);
    const color = RARE_COLORS[a.rare] || "#fff";
    return `
      <div class="achievement-item${isUnlocked ? "" : " locked"}" title="${isUnlocked ? a.desc : "Не получено"}">
        <div class="achievement-glow"></div>
        <div class="achievement-badge" style="color:${color};background:${color}22">${a.rare}</div>
        <div class="achievement-icon">${a.icon}</div>
        <div class="achievement-name">${a.name}</div>
        <div class="achievement-desc">${a.desc}</div>
      </div>`;
  }).join("");
}

