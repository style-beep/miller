---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<BaseLayout title="ПРОФИЛЬ | MILLER FAMILY">
  <PageHeader
    links={[
      { href: '/map.html', label: 'Карта' },
      { href: '/gallery.html', label: 'Галерея' },
    ]}
  />

  <main id="pageContent" style="opacity:1;transform:none">
    <section class="page-section">
      <div class="page-bg-title">PROFILE</div>
      <div id="profileContent" class="profile-wrap"></div>
    </section>
    <PageFooter />
  </main>
</BaseLayout>

<style>
  .profile-wrap { max-width: 900px; margin: 0 auto; }
  .profile-hero {
    display: flex; align-items: center; gap: 40px;
    padding: 40px; background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.07); border-radius: 20px;
    margin-bottom: 20px; position: relative; overflow: hidden;
  }
  .profile-hero::before { content:'';position:absolute;inset:0;background:radial-gradient(ellipse at left,rgba(255,42,42,0.08),transparent 60%);pointer-events:none; }
  .profile-photo { width:160px;height:160px;border-radius:16px;object-fit:cover;border:2px solid rgba(255,42,42,0.4);box-shadow:0 0 30px rgba(255,42,42,0.2);flex-shrink:0; }
  .profile-info { flex:1; }
  .profile-rank { font-size:10px;font-weight:700;letter-spacing:4px;color:rgba(255,42,42,0.7);text-transform:uppercase;margin-bottom:8px; }
  .profile-name { font-size:36px;font-weight:900;letter-spacing:3px;color:#fff;margin-bottom:6px; }
  .profile-role { font-size:14px;color:rgba(255,255,255,0.4);letter-spacing:2px;margin-bottom:20px; }
  .profile-badge { display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:6px;background:rgba(255,42,42,0.1);border:1px solid rgba(255,42,42,0.25);font-size:11px;font-weight:700;letter-spacing:2px;color:rgba(255,42,42,0.8); }
  .profile-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px; }
  .profile-stat { padding:20px;text-align:center;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.06);border-radius:12px;transition:border-color 0.3s; }
  .profile-stat:hover { border-color:rgba(255,42,42,0.2); }
  .profile-stat-val { font-size:28px;font-weight:900;color:#fff;display:block;margin-bottom:4px; }
  .profile-stat-key { font-size:10px;color:rgba(255,255,255,0.3);letter-spacing:2px;text-transform:uppercase; }
  .profile-bottom { display:grid;grid-template-columns:1fr 1fr;gap:14px; }
  .profile-card { padding:24px;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.06);border-radius:12px; }
  .profile-card-title { font-size:10px;font-weight:800;letter-spacing:3px;color:rgba(255,42,42,0.7);text-transform:uppercase;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.05); }
  .profile-card p { font-size:13px;color:rgba(255,255,255,0.45);line-height:1.7; }
  .profile-skill { display:flex;align-items:center;justify-content:space-between;margin-bottom:10px; }
  .profile-skill-name { font-size:12px;color:rgba(255,255,255,0.5); }
  .profile-skill-bar { flex:1;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin:0 12px;overflow:hidden; }
  .profile-skill-fill { height:100%;background:linear-gradient(90deg,#8a0000,#ff2a2a);border-radius:2px; }
  .profile-skill-val { font-size:11px;font-weight:700;color:rgba(255,42,42,0.8);min-width:36px;text-align:right; }
  @media(max-width:768px){
    .profile-hero{flex-direction:column;text-align:center;}
    .profile-grid{grid-template-columns:repeat(2,1fr);}
    .profile-bottom{grid-template-columns:1fr;}
    .profile-name{font-size:24px;}
  }

  .mypf { max-width:980px;margin:90px auto 60px;padding:0 20px;font-family:'Montserrat',sans-serif; }

  .mypf-hero {
    position:relative;border-radius:20px;overflow:hidden;margin-bottom:14px;
    background:linear-gradient(135deg,rgba(30,5,5,0.98) 0%,rgba(18,3,3,0.98) 100%);
    border:1px solid rgba(255,42,42,0.25);
    box-shadow:0 4px 40px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.04);
  }
  .mypf-banner {
    height:140px;
    background:linear-gradient(135deg,#2a0505 0%,#1a0202 35%,#0d0101 70%,#050000 100%);
    position:relative;overflow:hidden;
  }
  .mypf-banner::before {
    content:'';position:absolute;inset:0;
    background:radial-gradient(ellipse at 25% 60%,rgba(255,42,42,0.22) 0%,transparent 55%),
               radial-gradient(ellipse at 75% 30%,rgba(180,20,20,0.1) 0%,transparent 40%);
  }
  .mypf-banner::after {
    content:'';position:absolute;inset:0;opacity:0.06;
    background-image:repeating-linear-gradient(45deg,#fff 0,#fff 1px,transparent 0,transparent 50%);
    background-size:20px 20px;
  }
  .mypf-hero-body {
    display:flex;align-items:flex-end;gap:20px;padding:0 28px 24px;
    position:relative;margin-top:-52px;
  }
  .mypf-avatar-wrap { position:relative;flex-shrink:0; }
  .mypf-avatar {
    width:104px;height:104px;border-radius:50%;object-fit:cover;
    border:4px solid rgba(18,3,3,0.98);
    box-shadow:0 0 0 2px rgba(255,42,42,0.4),0 8px 24px rgba(0,0,0,0.7);
    display:block;
  }
  .mypf-avatar-placeholder {
    width:104px;height:104px;border-radius:50%;
    background:linear-gradient(135deg,rgba(255,42,42,0.2),rgba(180,0,0,0.1));
    border:4px solid rgba(18,3,3,0.98);
    box-shadow:0 0 0 2px rgba(255,42,42,0.3),0 8px 24px rgba(0,0,0,0.7);
    display:flex;align-items:center;justify-content:center;
    font-size:38px;font-weight:900;color:#ff2a2a;
  }
  .mypf-status-dot {
    position:absolute;bottom:5px;right:5px;width:18px;height:18px;
    border-radius:50%;border:3px solid rgba(18,3,3,0.98);
  }
  .mypf-status-dot.online  { background:#3ddc84; box-shadow:0 0 8px rgba(61,220,132,0.6); }
  .mypf-status-dot.idle    { background:#faa61a; box-shadow:0 0 8px rgba(250,166,26,0.5); }
  .mypf-status-dot.dnd     { background:#f04747; box-shadow:0 0 8px rgba(240,71,71,0.5); }
  .mypf-status-dot.offline { background:#4a4a4a; }

  .mypf-info { flex:1;min-width:0;padding-bottom:2px; }
  .mypf-role-label { font-size:9px;font-weight:700;letter-spacing:3px;text-transform:uppercase;margin-bottom:3px; }
  .mypf-name { font-size:24px;font-weight:900;letter-spacing:1.5px;color:#fff;margin:0 0 2px;
    text-shadow:0 2px 12px rgba(255,42,42,0.2); }
  .mypf-tag  { font-size:11px;color:rgba(255,255,255,0.25);letter-spacing:1px;margin-bottom:7px; }
  .mypf-bio  { font-size:12px;color:rgba(255,255,255,0.4);line-height:1.6;max-width:460px; }
  .mypf-status-text {
    display:inline-flex;align-items:center;gap:6px;margin-top:7px;
    font-size:11px;color:rgba(255,255,255,0.28);font-style:italic;
  }
  .mypf-actions {
    display:flex;flex-direction:column;gap:8px;align-items:flex-end;
    padding-bottom:2px;flex-shrink:0;
  }
  .mypf-edit-btn {
    display:flex;align-items:center;gap:8px;padding:10px 18px;
    border:1px solid rgba(255,42,42,0.4);border-radius:10px;
    background:rgba(255,42,42,0.1);color:#ff4444;
    font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;
    letter-spacing:2px;text-transform:uppercase;cursor:pointer;
    transition:all 0.2s;white-space:nowrap;
  }
  .mypf-edit-btn:hover { background:rgba(255,42,42,0.2);border-color:#ff2a2a;color:#fff; }
  .mypf-logout-btn {
    display:flex;align-items:center;gap:7px;padding:8px 14px;
    border:1px solid rgba(255,255,255,0.1);border-radius:10px;
    background:rgba(255,255,255,0.03);color:rgba(255,255,255,0.25);
    font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;
    letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:all 0.2s;
  }
  .mypf-logout-btn:hover { border-color:rgba(255,42,42,0.35);color:#ff2a2a; }

  .mypf-stats {
    display:grid;gap:10px;margin-bottom:14px;
    grid-template-columns:repeat(4,1fr);
  }
  .mypf-stat-card {
    padding:16px;
    background:linear-gradient(135deg,rgba(28,6,6,0.95),rgba(18,3,3,0.95));
    border:1px solid rgba(255,255,255,0.08);border-radius:14px;
    display:flex;align-items:center;gap:12px;
    transition:border-color 0.25s,transform 0.25s,box-shadow 0.25s;
    position:relative;overflow:hidden;
  }
  .mypf-stat-card::before {
    content:'';position:absolute;top:0;left:0;right:0;height:2px;
    background:var(--sc);opacity:0.5;border-radius:14px 14px 0 0;
  }
  .mypf-stat-card:hover {
    border-color:rgba(255,42,42,0.2);transform:translateY(-2px);
    box-shadow:0 8px 24px rgba(0,0,0,0.4);
  }
  .mypf-stat-icon {
    width:38px;height:38px;border-radius:9px;display:flex;
    align-items:center;justify-content:center;font-size:15px;flex-shrink:0;
  }
  .mypf-stat-body { min-width:0; }
  .mypf-stat-val { font-size:20px;font-weight:900;color:#fff;line-height:1; }
  .mypf-stat-label {
    font-size:8px;letter-spacing:1.5px;color:rgba(255,255,255,0.3);
    text-transform:uppercase;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }

  .mypf-grid { display:grid;grid-template-columns:260px 1fr;gap:12px; }
  .mypf-card {
    background:linear-gradient(135deg,rgba(28,6,6,0.95),rgba(18,3,3,0.95));
    border:1px solid rgba(255,255,255,0.08);
    border-radius:16px;padding:20px;
    box-shadow:0 2px 20px rgba(0,0,0,0.3);
  }
  .mypf-card + .mypf-card { margin-top:12px; }
  .mypf-card-title {
    font-size:9px;font-weight:800;letter-spacing:3px;
    color:rgba(255,42,42,0.65);text-transform:uppercase;margin-bottom:14px;
    padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.06);
    display:flex;align-items:center;gap:8px;
  }
  .mypf-card-title i { font-size:11px; }

  .mypf-roles { display:flex;flex-wrap:wrap;gap:6px; }
  .mypf-role-chip {
    padding:4px 11px;border-radius:20px;font-size:9px;font-weight:700;letter-spacing:1px;
  }

  .mypf-info-row {
    display:flex;justify-content:space-between;align-items:center;
    padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:12px;
  }
  .mypf-info-row:last-child { border-bottom:none; }
  .mypf-info-key { color:rgba(255,255,255,0.28);font-size:11px; }
  .mypf-info-val { color:rgba(255,255,255,0.75);font-weight:600;font-size:11px; }

  .mypf-tabs {
    display:flex;gap:4px;background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,255,255,0.06);
    border-radius:12px;padding:4px;margin-bottom:12px;
  }
  .mypf-tab {
    flex:1;padding:9px;border:none;background:none;
    color:rgba(255,255,255,0.3);font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
    border-radius:9px;cursor:pointer;transition:all 0.2s;
  }
  .mypf-tab.active {
    background:rgba(255,42,42,0.14);color:#ff4444;
    box-shadow:0 0 0 1px rgba(255,42,42,0.25);
  }
  .mypf-tabpanel { display:none; }
  .mypf-tabpanel.active { display:block; }

  .mypf-ach-grid {
    display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:9px;
  }
  .mypf-ach {
    display:flex;flex-direction:column;align-items:center;gap:7px;
    padding:15px 8px 12px;text-align:center;
    background:rgba(255,255,255,0.02);
    border:1px solid rgba(255,255,255,0.07);border-radius:12px;
    position:relative;overflow:hidden;transition:all 0.22s;cursor:default;
  }
  .mypf-ach:not(.locked):hover { transform:translateY(-3px); }
  .mypf-ach.locked { opacity:0.18;filter:grayscale(1); }
  .mypf-ach.locked:hover { transform:none; }

  .mypf-ach[data-rare="MYTHIC"]:not(.locked) {
    border-color:rgba(255,60,120,0.5);
    box-shadow:0 0 16px rgba(255,60,120,0.2),inset 0 0 20px rgba(255,60,120,0.05);
    animation:achMythicPulse 3s ease-in-out infinite;
  }
  .mypf-ach[data-rare="GOD"]:not(.locked) {
    border-color:rgba(255,215,0,0.6);
    box-shadow:0 0 24px rgba(255,215,0,0.25),inset 0 0 30px rgba(255,215,0,0.06);
    animation:achGodPulse 2.5s ease-in-out infinite;
  }
  .mypf-ach[data-rare="LEGENDARY"]:not(.locked) {
    border-color:rgba(255,152,0,0.45);
    box-shadow:0 0 12px rgba(255,152,0,0.15);
  }
  .mypf-ach[data-rare="EPIC"]:not(.locked) {
    border-color:rgba(156,39,176,0.4);
    box-shadow:0 0 10px rgba(156,39,176,0.12);
  }
  @keyframes achMythicPulse {
    0%,100% { box-shadow:0 0 16px rgba(255,60,120,0.2),inset 0 0 20px rgba(255,60,120,0.05); }
    50%      { box-shadow:0 0 28px rgba(255,60,120,0.35),inset 0 0 30px rgba(255,60,120,0.1); }
  }
  @keyframes achGodPulse {
    0%,100% { box-shadow:0 0 24px rgba(255,215,0,0.25),inset 0 0 30px rgba(255,215,0,0.06); }
    50%      { box-shadow:0 0 40px rgba(255,215,0,0.45),inset 0 0 40px rgba(255,215,0,0.12); }
  }

  .mypf-ach-shine {
    position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(ellipse at top,var(--ach-shine,transparent) 0%,transparent 65%);
    opacity:0.12;
  }
  .mypf-ach-badge {
    position:absolute;top:5px;right:5px;font-size:7px;font-weight:800;
    letter-spacing:0.5px;padding:2px 5px;border-radius:4px;
    text-shadow:0 1px 3px rgba(0,0,0,0.5);
  }
  .mypf-ach-icon { font-size:26px;line-height:1;position:relative;z-index:1; }
  .mypf-ach-name { font-size:8px;font-weight:700;letter-spacing:1px;color:#fff;text-transform:uppercase;line-height:1.3;position:relative;z-index:1; }
  .mypf-ach-desc { font-size:8px;color:rgba(255,255,255,0.28);line-height:1.4;position:relative;z-index:1; }

  .mypf-ach[data-rare="GOD"]:not(.locked) .mypf-ach-name {
    background:linear-gradient(90deg,#ffd700,#fff8dc,#ffa500,#ffd700);
    background-size:200% auto;
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    animation:godShimmer 2s linear infinite;
  }
  @keyframes godShimmer { to { background-position:200% center; } }

  .mypf-bio-full { font-size:13px;color:rgba(255,255,255,0.45);line-height:1.85; }

  .pf-modal-overlay {
    position:fixed;inset:0;z-index:2000;
    background:rgba(0,0,0,0.88);backdrop-filter:blur(10px);
    display:none;align-items:center;justify-content:center;padding:20px;
  }
  .pf-modal-overlay.open { display:flex; }
  .pf-modal {
    width:100%;max-width:540px;max-height:88vh;overflow-y:auto;
    background:linear-gradient(160deg,rgba(22,4,4,0.99),rgba(12,2,2,0.99));
    border:1px solid rgba(255,42,42,0.25);
    border-radius:20px;padding:0;position:relative;
    box-shadow:0 32px 80px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.02);
  }
  .pf-modal-head {
    padding:24px 28px 0;display:flex;align-items:center;justify-content:space-between;
    border-bottom:1px solid rgba(255,255,255,0.05);padding-bottom:18px;
  }
  .pf-modal-title { font-size:13px;font-weight:900;letter-spacing:3px;color:#fff;text-transform:uppercase; }
  .pf-modal-close {
    background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);
    border-radius:8px;color:rgba(255,255,255,0.4);
    font-size:14px;cursor:pointer;padding:6px 9px;transition:all 0.2s;line-height:1;
  }
  .pf-modal-close:hover { background:rgba(255,42,42,0.15);border-color:rgba(255,42,42,0.3);color:#ff4444; }
  .pf-modal-tabs { display:flex;gap:0;padding:0 28px;border-bottom:1px solid rgba(255,255,255,0.05); }
  .pf-modal-tab {
    padding:14px 16px;border:none;background:none;
    color:rgba(255,255,255,0.3);font-family:'Montserrat',sans-serif;
    font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
    border-bottom:2px solid transparent;cursor:pointer;transition:all 0.2s;
  }
  .pf-modal-tab.active { color:#ff4444;border-bottom-color:#ff2a2a; }
  .pf-modal-body { padding:22px 28px 28px; }
  .pf-modal-panel { display:none; }
  .pf-modal-panel.active { display:block; }

  .pf-field { margin-bottom:16px; }
  .pf-label {
    display:block;font-size:9px;font-weight:700;letter-spacing:2px;
    color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:6px;
  }
  .pf-input, .pf-textarea {
    width:100%;background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.09);border-radius:9px;
    padding:11px 14px;color:#fff;font-family:'Montserrat',sans-serif;
    font-size:13px;font-weight:500;outline:none;
    transition:border-color 0.2s,background 0.2s;box-sizing:border-box;
  }
  .pf-input:focus, .pf-textarea:focus { border-color:rgba(255,42,42,0.45);background:rgba(255,42,42,0.03); }
  .pf-input::placeholder, .pf-textarea::placeholder { color:rgba(255,255,255,0.18); }
  .pf-textarea { resize:vertical;min-height:88px; }

  .pf-stats-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px; }

  .pf-ach-check-grid { display:grid;grid-template-columns:1fr 1fr;gap:7px; }
  .pf-ach-check {
    display:flex;align-items:center;gap:9px;padding:9px 11px;
    border:1px solid rgba(255,255,255,0.07);border-radius:9px;cursor:pointer;
    transition:border-color 0.2s,background 0.2s;
  }
  .pf-ach-check:hover { border-color:rgba(255,42,42,0.2);background:rgba(255,42,42,0.03); }
  .pf-ach-check.checked { background:rgba(255,42,42,0.07);border-color:rgba(255,42,42,0.3); }
  .pf-ach-check input { display:none; }
  .pf-ach-check-box {
    width:17px;height:17px;border:2px solid rgba(255,255,255,0.15);
    border-radius:5px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
    font-size:9px;transition:all 0.15s;
  }
  .pf-ach-check.checked .pf-ach-check-box { background:#cc0000;border-color:#cc0000;color:#fff; }
  .pf-ach-check-icon { font-size:15px; }
  .pf-ach-check-name { font-size:9px;font-weight:700;color:rgba(255,255,255,0.55);letter-spacing:1px;text-transform:uppercase; }

  .pf-save-btn {
    width:100%;padding:13px;
    background:linear-gradient(135deg,#cc0000,#7a0000);
    border:none;border-radius:9px;color:#fff;font-family:'Montserrat',sans-serif;
    font-size:11px;font-weight:900;letter-spacing:3px;text-transform:uppercase;
    cursor:pointer;margin-top:8px;transition:opacity 0.2s,transform 0.15s;
    box-shadow:0 4px 16px rgba(200,0,0,0.3);
  }
  .pf-save-btn:hover { opacity:0.88;transform:translateY(-1px); }
  .pf-save-btn:disabled { opacity:0.35;cursor:not-allowed;transform:none;box-shadow:none; }

  @media(max-width:900px){
    .mypf-grid { grid-template-columns:1fr; }
    .mypf-stats { grid-template-columns:repeat(2,1fr); }
  }
  @media(max-width:600px){
    .mypf-hero-body { flex-wrap:wrap; }
    .mypf-actions { align-items:flex-start;flex-direction:row;flex-wrap:wrap; }
    .pf-stats-grid,.pf-ach-check-grid { grid-template-columns:1fr; }
    .pf-modal-body { padding:18px; }
    .pf-modal-head { padding:18px 18px 16px; }
    .pf-modal-tabs { padding:0 18px; }
    .mypf-stats { grid-template-columns:repeat(2,1fr); }
  }

  /* ── Achievements (static profile) ── */
  .achievements-section { margin-top: 14px; }
  .achievements-title {
    font-size: 10px; font-weight: 800; letter-spacing: 3px;
    color: rgba(255,42,42,0.7); text-transform: uppercase;
    margin-bottom: 14px; padding-bottom: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .achievements-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
  }
  .achievement-item {
