---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLoader from '../components/PageLoader.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<BaseLayout title="СОЮЗНИКИ | MILLER FAMILY">
  <PageLoader
    barTitle="MILLER FAMILY · ALLIANCE SYSTEM"
    logoSub="Alliance Registry"
    section="СОЮЗНИКИ"
    initialLabel="Загрузка реестра союзников..."
    barMetaLabel="ПРОВЕРКА ПАКТОВ"
  />

  <PageHeader
    links={[
      { href: '/gallery.html', label: 'Галерея' },
      { href: '/history.html', label: 'История' },
      { href: '/media.html', label: 'Медиа' },
    ]}
  />

  <main id="pageContent">
    <section class="page-section">
      <div class="page-bg-title">ALLIES</div>
      <h1 class="page-section-title">Наши союзники</h1>
      <p class="page-section-sub">Организации с пактом о ненападении · Miller Family</p>

      <div class="allies-grid" id="alliesGrid"></div>

      <div class="allies-note">
        <i class="fa-solid fa-handshake" style="color:rgba(255,42,42,0.4);margin-right:8px"></i>
        Союзники добавляются через <code style="color:rgba(255,42,42,0.5)">events.config.js</code> в массив <code style="color:rgba(255,42,42,0.5)">ALLIES</code>
      </div>
    </section>

    <PageFooter />
  </main>
</BaseLayout>

<style>
  .allies-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ally-card {
    position: relative;
    padding: 32px 24px;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    text-align: center;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .ally-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255,42,42,0.3);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
  }
  .ally-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, rgba(255,42,42,0.05), transparent 65%);
    pointer-events: none;
  }

  .ally-status {
    position: absolute;
    top: 14px; right: 14px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #4caf50;
    box-shadow: 0 0 8px rgba(76,175,80,0.6);
  }
  .ally-status.inactive { background: #666; box-shadow: none; }

  .ally-logo {
    width: 72px; height: 72px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid rgba(255,255,255,0.1);
    margin: 0 auto 16px;
    display: block;
  }
  .ally-tag {
    font-size: 9px; font-weight: 700;
    letter-spacing: 3px; color: rgba(255,42,42,0.6);
    text-transform: uppercase; margin-bottom: 6px;
  }
  .ally-name {
    font-size: 16px; font-weight: 900;
    letter-spacing: 2px; color: #fff;
    margin-bottom: 12px;
  }
  .ally-desc {
    font-size: 12px; color: rgba(255,255,255,0.4);
    line-height: 1.7; margin-bottom: 20px;
  }
  .ally-since {
    font-size: 10px; color: rgba(255,255,255,0.2);
    letter-spacing: 2px; margin-bottom: 16px;
    text-transform: uppercase;
  }
  .ally-discord {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 8px;
    background: rgba(88,101,242,0.15);
    border: 1px solid rgba(88,101,242,0.3);
    color: rgba(88,101,242,0.9);
    text-decoration: none; font-size: 11px;
    font-weight: 700; letter-spacing: 2px;
    transition: background 0.2s, border-color 0.2s;
  }
  .ally-discord:hover {
    background: rgba(88,101,242,0.25);
    border-color: rgba(88,101,242,0.6);
    color: #fff;
  }

  .allies-empty {
    grid-column: 1/-1; text-align: center;
    padding: 60px 20px;
    color: rgba(255,255,255,0.2); font-size: 14px;
  }
  .allies-empty i { font-size: 40px; display: block; margin-bottom: 16px; opacity: 0.3; }

  .allies-note {
    max-width: 600px; margin: 32px auto 0;
    padding: 16px 24px; border-radius: 10px;
    background: rgba(255,42,42,0.05);
    border: 1px solid rgba(255,42,42,0.15);
    font-size: 12px; color: rgba(255,255,255,0.3);
    text-align: center; line-height: 1.6;
  }

  @media (max-width: 768px) {
    .allies-grid { grid-template-columns: 1fr; max-width: 360px; }
  }
</style>

<script type="module" is:inline>
  import { requireAuth }    from "/js/auth-guard.js";
  import { initPageLoader } from "/js/page-loader.js";
  import { initPageTransition } from "/js/page-transition.js";
  import { initEasterEgg }      from "/js/easter-egg.js";
  import { ALLIES }         from "/js/config/events.js";

  requireAuth().then(user => {
    if (!user) return;
    initPageTransition();
    initEasterEgg();
    initPageLoader({
      password: "MF·ALLIANCE·PACT·2026",
      label:    "ЗАГРУЗКА РЕЕСТРА СОЮЗНИКОВ",
      onComplete: render,
    });
  });

  function render() {
    const grid = document.getElementById("alliesGrid");

    if (!ALLIES.length) {
      grid.innerHTML = `
        <div class="allies-empty">
          <i class="fa-solid fa-handshake-slash"></i>
          Союзники ещё не добавлены.<br>
          Добавь их в <code>events.config.js</code> в массив <code>ALLIES</code>
        </div>`;
      return;
    }

    grid.innerHTML = ALLIES.map((a, i) => `
      <div class="ally-card" style="animation-delay:${i*0.1}s">
        <div class="ally-status ${a.status === 'active' ? '' : 'inactive'}"></div>
        <img loading="lazy" src="${a.logo}" alt="${a.name}" class="ally-logo">
        <div class="ally-tag">${a.tag}</div>
        <div class="ally-name">${a.name}</div>
        <div class="ally-desc">${a.desc}</div>
        <div class="ally-since">В союзе с: ${a.since}</div>
        <a href="${a.discord}" target="_blank" class="ally-discord">
          <i class="fa-brands fa-discord"></i> DISCORD
        </a>
      </div>
    `).join("");

    const obs = new IntersectionObserver(entries => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.style.opacity = '1', i * 100);
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    grid.querySelectorAll(".ally-card").forEach(c => {
      c.style.opacity = '0';
      c.style.transition = 'opacity 0.5s ease, transform 0.3s, border-color 0.3s, box-shadow 0.3s';
      obs.observe(c);
    });
  }
</script>
