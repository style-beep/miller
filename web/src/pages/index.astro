  <script is:inline>
  (function() {
    const canvas = document.getElementById('fireCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const img  = document.getElementById('emblemImg');

    let W, H, cx, cy, IR;
    let particles = [];
    let embers = [];
    let drips = [];
    let raf;

    function setup() {
      const wrap = canvas.parentElement;
      W = wrap.offsetWidth;
      H = wrap.offsetHeight;
      canvas.width  = W;
      canvas.height = H;
      cx = W / 2;
      cy = H / 2;
      IR = Math.min(W, H) * 0.34;
    }

    function rand(a, b) { return a + Math.random() * (b - a); }

    function spawnFire() {
      const angle = rand(Math.PI * 0.55, Math.PI * 0.95);
      const r = IR * rand(0.85, 1.05);
      const x = cx + Math.cos(angle) * r;
      const y = cy + Math.sin(angle) * r;
      particles.push({
        x, y,
        vx: rand(-0.6, 0.6),
        vy: rand(-2.8, -1.2),
        life: rand(0.6, 1.0),
        maxLife: 1,
        size: rand(4, 11),
      });
    }

    function spawnEmber() {
      const angle = rand(Math.PI * 0.5, Math.PI);
      const r = IR * rand(0.9, 1.1);
      embers.push({
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
        vx: rand(-1.2, 1.2),
        vy: rand(-3, -1),
        life: rand(0.4, 0.9),
        size: rand(1.5, 3.5),
      });
    }

    function spawnDrip() {
      const angle = rand(Math.PI * 0.6, Math.PI * 0.92);
      const r = IR * rand(0.92, 1.0);
      drips.push({
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r,
        vy: rand(1.5, 3.5),
        len: rand(10, 35),
        life: rand(0.7, 1.2),
        maxLife: 1,
        w: rand(2, 5),
      });
    }

    let t = 0;
    function frame() {
      raf = requestAnimationFrame(frame);
      t += 0.016;

      ctx.clearRect(0, 0, W, H);

      if (Math.random() < 0.55) spawnFire();
      if (Math.random() < 0.18) spawnEmber();
      if (Math.random() < 0.06) spawnDrip();

      const DT = 0.018;

      particles.forEach((p, i) => {
        p.x  += p.vx; p.y  += p.vy;
        p.vx += rand(-0.15, 0.15);
        p.life -= DT * 1.1;
        if (p.life <= 0) { particles.splice(i, 1); return; }
        const a = p.life;
        const pct = 1 - p.life;
        let r2, g, b;
        if (pct < 0.25)      { r2=255; g=Math.round(200+55*(1-pct/0.25)); b=Math.round(180*(1-pct/0.25)); }
        else if (pct < 0.55) { r2=255; g=Math.round(160*(1-(pct-0.25)/0.3)); b=0; }
        else                  { r2=Math.round(255*(1-(pct-0.55)/0.45)); g=0; b=0; }

        ctx.globalAlpha = a * 0.85;
        ctx.shadowBlur  = 14; ctx.shadowColor = `rgba(255,60,0,${a})`;
        const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
        grad.addColorStop(0, `rgba(${r2},${g},${b},${a})`);
        grad.addColorStop(1, `rgba(${r2},0,0,0)`);
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
      });

      embers.forEach((e, i) => {
        e.x += e.vx; e.y += e.vy; e.vy += 0.04;
        e.life -= DT * 1.4;
        if (e.life <= 0) { embers.splice(i, 1); return; }
        ctx.globalAlpha = e.life;
        ctx.shadowBlur  = 8; ctx.shadowColor = '#ff6600';
        ctx.fillStyle = `rgba(255,${Math.round(100+e.life*100)},0,1)`;
        ctx.beginPath(); ctx.arc(e.x, e.y, e.size, 0, Math.PI * 2);
        ctx.fill();
      });

      drips.forEach((d, i) => {
        d.y  += d.vy; d.len += d.vy * 0.5;
        d.life -= DT * 0.9;
        if (d.life <= 0) { drips.splice(i, 1); return; }
        const a = Math.min(d.life, 0.85);
        ctx.globalAlpha = a;
        ctx.shadowBlur  = 6; ctx.shadowColor = 'rgba(180,0,0,0.8)';
        ctx.strokeStyle = `rgba(160,0,0,${a})`;
        ctx.lineWidth   = d.w;
        ctx.lineCap     = 'round';
        ctx.beginPath(); ctx.moveTo(d.x, d.y - d.len * 0.3); ctx.lineTo(d.x, d.y + d.len);
        ctx.stroke();
        ctx.fillStyle = `rgba(140,0,0,${a})`;
        ctx.beginPath(); ctx.arc(d.x, d.y + d.len, d.w * 1.5, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.shadowBlur = 0; ctx.globalAlpha = 1; ctx.lineCap = 'butt';
    }

    function start() {
      setup();
      window.addEventListener('resize', setup);
      frame();
    }

    if (img.complete) start();
    else img.addEventListener('load', start);
  })();
  </script>
