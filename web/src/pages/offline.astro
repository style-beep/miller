---
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Нет соединения | MILLER FAMILY</title>
  <link rel="icon" type="image/png" href="/images/family-logo.jpeg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
</head>
<body>
  <div class="bg"></div>
  <div class="grid-bg"></div>
  <div class="tape-top"></div>
  <div class="tape-bot"></div>

  <div class="wrap">

    <div class="signal-wrap">
      <div class="signal-rings"></div>
      <div class="signal-rings"></div>
      <div class="signal-rings"></div>
      <i class="fa-solid fa-wifi signal-icon"></i>
    </div>

    <div class="status-badge">
      <div class="blink-dot"></div>
      ERR_INTERNET_DISCONNECTED
    </div>

    <div class="title">
      <div class="title-main">НЕТ</div>
      <div class="title-sub">СОЕДИНЕНИЯ</div>
    </div>

    <div class="sep"><span>статус</span></div>

    <div class="desc">
      Связь с сервером <em>Del Perro RP</em> потеряна.<br>
      Проверь подключение и попробуй снова.<br>
      <em>Часть контента доступна в офлайн-режиме.</em>
    </div>

    <div class="btn-row">
      <button class="btn btn-primary" onclick="location.reload()">
        <i class="fa-solid fa-rotate-right"></i> Попробовать снова
      </button>
    </div>

    <div class="terminal">
      <div class="terminal-line"><span class="prompt">$</span> ping delperro.rp</div>
      <div class="terminal-line"><span class="prompt">></span> <span class="err">Request timeout for icmp_seq 0</span></div>
      <div class="terminal-line"><span class="prompt">></span> <span class="err">Request timeout for icmp_seq 1</span></div>
      <div class="terminal-line"><span class="prompt">></span> <span class="err">Host unreachable — no route to host</span></div>
      <div class="terminal-line" style="margin-top:8px"><span class="prompt">$</span> status connection<span class="cur"></span></div>
    </div>

    <div class="status-row">
      <div class="status-item">
        <i class="fa-solid fa-circle" style="color:rgba(255,42,42,0.4)"></i>
        <span>Интернет: <span style="color:rgba(255,42,42,0.6)">Offline</span></span>
      </div>
      <div class="status-item">
        <i class="fa-solid fa-circle" style="color:rgba(67,181,129,0.5)"></i>
        <span>Кэш: <span style="color:rgba(67,181,129,0.6)">Активен</span></span>
      </div>
      <div class="status-item" id="timeItem">
        <i class="fa-solid fa-clock" style="color:rgba(255,255,255,0.2)"></i>
        <span id="offlineTime">00:00</span>
      </div>
    </div>

  </div>

  <div class="footer">MILLER FAMILY · DEL PERRO RP · 2023–2026</div>

  <script is:inline>
    let secs = 0;
    setInterval(() => {
      secs++;
      const m = String(Math.floor(secs/60)).padStart(2,'0');
      const s = String(secs%60).padStart(2,'0');
      document.getElementById('offlineTime').textContent = `Офлайн: ${m}:${s}`;
    }, 1000);

    window.addEventListener('online', () => {
      document.querySelector('.status-badge').innerHTML =
        '<div class="blink-dot" style="background:#43b581"></div> СОЕДИНЕНИЕ ВОССТАНОВЛЕНО';
      setTimeout(() => location.href = '/', 1200);
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root { --red: #ff2a2a; }

  body {
    font-family: 'Montserrat', sans-serif;
    background: #050505; color: #fff;
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 20px;
    overflow: hidden;
    position: relative;
  }

  .bg {
    position: fixed; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(120,0,0,0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 70%, rgba(80,0,0,0.08) 0%, transparent 50%),
      #050505;
  }
  .bg::after {
    content: '';
    position: fixed; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(
      0deg, transparent 0px, transparent 2px,
      rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 3px
    );
  }

  .grid-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,42,42,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,42,42,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridMove 20s linear infinite;
  }
  @keyframes gridMove { to { background-position: 60px 60px; } }

  .tape-top, .tape-bot {
    position: fixed; left: 0; right: 0; height: 4px; z-index: 10;
    background: repeating-linear-gradient(
      -45deg, rgba(200,0,0,0.7) 0px, rgba(200,0,0,0.7) 14px,
      rgba(0,0,0,0.6) 14px, rgba(0,0,0,0.6) 28px
    );
  }
  .tape-top { top: 0; }
  .tape-bot { bottom: 0; }

  .wrap { position: relative; z-index: 1; max-width: 540px; width: 100%; }

  .signal-wrap {
    position: relative; display: inline-block;
    margin-bottom: 28px;
  }
  .signal-icon {
    font-size: 56px; color: rgba(255,42,42,0.25);
    filter: drop-shadow(0 0 20px rgba(255,42,42,0.15));
    animation: signalPulse 2.5s ease-in-out infinite;
  }
  @keyframes signalPulse {
    0%,100% { color: rgba(255,42,42,0.2); filter: drop-shadow(0 0 10px rgba(255,42,42,0.1)); }
    50%     { color: rgba(255,42,42,0.45); filter: drop-shadow(0 0 24px rgba(255,42,42,0.3)); }
  }
  .signal-rings {
    position: absolute; inset: -20px;
    border: 1px solid rgba(255,42,42,0.1);
    border-radius: 50%; animation: ringOut 2.5s ease-out infinite;
  }
  .signal-rings:nth-child(2) { inset: -36px; animation-delay: 0.5s; }
  .signal-rings:nth-child(3) { inset: -52px; animation-delay: 1s; }
  @keyframes ringOut {
    0%   { opacity: 0.5; transform: scale(0.8); }
    100% { opacity: 0;   transform: scale(1.3); }
  }

  .status-badge {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,42,42,0.07); border: 1px solid rgba(255,42,42,0.2);
    border-radius: 6px; padding: 6px 16px; margin-bottom: 24px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px; color: rgba(255,42,42,0.6); letter-spacing: 2px;
  }
  .blink-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--red); opacity: 0.7;
    animation: blink 1.1s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:0.7} 50%{opacity:0.1} }

  .title {
    font-size: clamp(32px, 8vw, 64px); font-weight: 900;
    letter-spacing: 3px; line-height: 1.1;
    margin-bottom: 8px;
  }
  .title-main { color: #fff; }
  .title-sub  { color: rgba(255,42,42,0.7); }

  .sep {
    display: flex; align-items: center; gap: 14px;
    margin: 20px auto 20px; max-width: 320px;
  }
  .sep::before, .sep::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,42,42,0.25), transparent);
  }
  .sep span {
    font-size: 9px; letter-spacing: 3px;
    color: rgba(255,42,42,0.35); text-transform: uppercase;
  }

  .desc {
    font-size: 13px; color: rgba(255,255,255,0.28);
    line-height: 1.9; letter-spacing: 0.5px;
    margin-bottom: 32px;
    font-family: 'Share Tech Mono', monospace;
  }
  .desc em { color: rgba(255,255,255,0.5); font-style: normal; }

  .btn-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 26px;
    border-radius: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 10px; font-weight: 800;
    letter-spacing: 2px; text-decoration: none;
    text-transform: uppercase; cursor: pointer;
    transition: all 0.2s; border: 1px solid;
  }
  .btn-primary {
    background: rgba(255,42,42,0.1); border-color: rgba(255,42,42,0.35);
    color: rgba(255,80,80,0.9);
  }
  .btn-primary:hover {
    background: rgba(255,42,42,0.2); border-color: rgba(255,42,42,0.6);
    color: #fff; transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,42,42,0.2);
  }

  .terminal {
    background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px; padding: 16px 20px; text-align: left;
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px; color: rgba(255,255,255,0.35);
    max-width: 420px; margin: 0 auto;
  }
  .terminal-line { margin-bottom: 4px; }
  .terminal-line .prompt { color: rgba(255,42,42,0.5); margin-right: 8px; }
  .terminal-line .ok     { color: rgba(67,181,129,0.7); }
  .terminal-line .err    { color: rgba(255,42,42,0.6); }
  .terminal-line .cur    {
    display: inline-block; width: 8px; height: 14px;
    background: rgba(255,42,42,0.5); vertical-align: middle;
    animation: blink 1s step-end infinite; margin-left: 2px;
  }

  .status-row {
    display: flex; justify-content: center; gap: 20px;
    flex-wrap: wrap; margin-top: 32px;
  }
  .status-item {
    display: flex; align-items: center; gap: 7px;
    font-size: 10px; letter-spacing: 1px;
    color: rgba(255,255,255,0.2); text-transform: uppercase;
  }
  .status-item i { font-size: 11px; }

  .footer {
    position: fixed; bottom: 14px;
    font-size: 9px; letter-spacing: 3px;
    color: rgba(255,255,255,0.06); text-transform: uppercase;
  }
</style>
